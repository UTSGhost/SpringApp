### 1. register new user
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "name": "tester",
  "email": "tester@test.de",
  "password": "strengGeheim123"
}

### 2. register same user (400)
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "name": "Tobias",
  "email": "tobias@test.de",
  "password": "strengGeheim123"
}

### 3. login success
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "tobias@test.de",
  "password": "strengGeheim123"
}

### 4. login wrong password (401)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "tobias@test.de",
  "password": "falschesPasswort"
}

### 5. try to access without login
GET http://localhost:8080/api/users/me
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJ0b2JpYXNAdGVzdC5kZSIsImlhdCI6MTc4ODA4MzE3NiwiZXhwIjoxNzg4MTY5NTc2fQ.ipDrUPNO7qf-JpgVFsz9taiKOCr7VtDrOUnE0Fg2sM8